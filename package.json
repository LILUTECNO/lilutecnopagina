{
  "name": "lilutecno-ecommerce",
  "private": true,
  "version": "0.0.0",
  "homepage": "https://LILUTECNO.github.io/lilutecnopagina",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "tsc",
    "preview": "vite preview",
    "deploy": "gh-pages -d dist",
    "firebase:login": "npx firebase login",
    "firebase:init": "npx firebase init",
    "firebase:deploy": "npm run build && npx firebase deploy",
    "firebase:deploy:hosting": "npm run build && npx firebase deploy --only hosting",
    "firebase:deploy:functions": "node scripts/deploy-functions.mjs",
    "firebase:deploy:firestore": "npx firebase deploy --only firestore",
    "firebase:deploy:storage": "npx firebase deploy --only storage",
    "firebase:deploy:rules": "npx firebase deploy --only firestore:rules,storage:rules",
    "firebase:serve": "npx firebase emulators:start",
    "firebase:emulators": "npx firebase emulators:start --only auth,firestore,hosting",
    "firebase:test:functions": "npm --prefix functions run build && npx firebase emulators:exec --only auth,functions,firestore \"node scripts/test-functions-local.mjs\"",
    "firebase:config:export": "npx firebase functions:config:export"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "axios": "^1.11.0",
    "firebase": "^12.2.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "lucide-react": "^1.21.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.5.0",
    "firebase-admin": "^14.2.0",
    "gh-pages": "^6.3.0",
    "postcss": "^8.5.15",
    "postcss-import": "^16.1.1",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "typescript": "^5.5.3",
    "vite": "^7.1.4"
  }
}
