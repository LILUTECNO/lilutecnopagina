rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function signedIn() {
      return request.auth != null;
    }

    function isImage() {
      return request.resource != null &&
        request.resource.contentType != null &&
        request.resource.contentType.matches('image/.*');
    }

    function underSize(bytes) {
      return request.resource.size < bytes;
    }

    // Imágenes de productos — products/{productId}/{allPaths=**}
    match /products/{productId}/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn() && isImage() && underSize(10 * 1024 * 1024);
    }

    // Carrusel de inicio (banners) — heroSlides/{allPaths=**}
    match /heroSlides/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn() && isImage() && underSize(10 * 1024 * 1024);
    }

    // Logos de proveedor — providerLogos/{userId}/{allPaths=**}
    match /providerLogos/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn() && isImage() && underSize(5 * 1024 * 1024);
    }

    // Avatares de usuario — users/{userId}/avatar/{allPaths=**}
    match /users/{userId}/avatar/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == userId && isImage() && underSize(5 * 1024 * 1024);
    }

    // Fotos de validación en bodega (módulo logística)
    match /validationPhotos/{orderId}/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn() && isImage() && underSize(10 * 1024 * 1024);
    }

    // Logos de tiendas — stores/{storeId}/logo/{allPaths=**}
    match /stores/{storeId}/logo/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn() && isImage() && underSize(5 * 1024 * 1024);
    }

    // Regla por defecto: bloqueo todo lo demás
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
